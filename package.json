{
  "name": "schedrift",
  "version": "1.0.0",
  "private": true,
  "description": "Schedrift: local-first interactive Gantt chart and dependency-driven delay simulation for Microsoft Project schedules.",
  "type": "module",
  "license": "MIT",
  "author": "JervilAngelo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jervilangelo/schedrift.git"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "sample": "tsx scripts/generate-sample.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
